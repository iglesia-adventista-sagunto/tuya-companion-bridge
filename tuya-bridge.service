[Unit]
Description=Tuya Companion HTTP Bridge
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/tuya-companion-bridge
ExecStart=/opt/tuya-companion-bridge/venv/bin/gunicorn -w 1 --threads 4 -b 0.0.0.0:5000 app:app
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
